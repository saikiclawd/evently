# ═══════════════════════════════════════════
# FloraFlow — Environment Configuration
# ═══════════════════════════════════════════
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ──
FLASK_ENV=production
FLASK_CONFIG=production
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
APP_DOMAIN=app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Monolithic mode: Flask serves the built React SPA
SERVE_STATIC=1

# ── Database (PostgreSQL on same host) ──
# The linode-setup.sh script creates the floraflow user/db automatically.
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://floraflow:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/floraflow

# ── AI — Groq API (required for AI Stem Analyzer) ──
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Logging ──
LOG_LEVEL=info
# Gunicorn worker count (default: 2×cores+1)
# GUNICORN_WORKERS=5

# ── Optional: Stripe ──
# STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
# STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX
# STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# ── Optional: SendGrid ──
# SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXX
# FROM_EMAIL=noreply@yourdomain.com

# ── Optional: Google OAuth ──
# GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXX
# GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXX

# ── Optional: Linode Object Storage (S3-compatible) ──
# S3_ENDPOINT=https://us-east-1.linodeobjects.com
# S3_ACCESS_KEY=XXXXXXXX
# S3_SECRET_KEY=XXXXXXXX
# S3_BUCKET=floraflow-uploads
# S3_REGION=us-east-1

# ── Optional: Monitoring ──
# SENTRY_DSN=https://XXXXXXXX@sentry.io/XXXXXXXX
